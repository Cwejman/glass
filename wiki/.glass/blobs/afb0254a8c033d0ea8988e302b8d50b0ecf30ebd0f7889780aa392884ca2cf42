{"body":{"language":"ts","text":"async function commit(change: Change) {\n  const reach = reachOf(change)                // known from the change alone\n  await order(reach)                           // wait only on changes it meets\n  const placed = place(change)                 // each holon to its store\n  const problems = judge(placed)               // every problem at once\n  if (problems.length) return { refused: problems }\n  const { act, ids } = mint(placed)            // which handle became which id\n  const reply = await offer(write(act))        // a line per store, to each head\n  if (reply === \"moved\") return commit(change) // again, over what was taken in\n  return { act, ids }\n}"},"id":"1M78WP0TEMPG2HY","instance":["1M6YBY3G0000011"]}
