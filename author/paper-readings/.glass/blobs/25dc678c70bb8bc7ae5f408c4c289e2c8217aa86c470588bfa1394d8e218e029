{"body":{"matters":"the shortfall being answered","parts":[{"$holds":true,"$ref":"1M6YBY3G10000CA"},{"$holds":true,"$ref":"1M6YBY3G10001SM"},{"$holds":true,"$ref":"1M6YBY3G100022Q"},{"$holds":true,"$ref":"1M6YBY3G10002AR"},{"$holds":true,"$ref":"1M6YBY3G10002EY"},{"$holds":true,"$ref":"1M6YBY3G10003MJ"}],"prose":"Brittle adaptation, embedded bias, missing accountability and thin awareness are named first; the roles are cut to fit them.","title":"The gaps the roles answer"},"id":"1M6YBY3G200007A","instance":["1M6YBY3G000000K"]}
