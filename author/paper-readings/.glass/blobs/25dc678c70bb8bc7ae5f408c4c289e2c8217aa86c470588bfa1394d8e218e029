{"body":{"matters":"rank in the nest","parts":[{"$holds":true,"$ref":"1M6YBY3G10000S5"},{"$holds":true,"$ref":"1M6YBY3G10000XY"},{"$holds":true,"$ref":"1M6YBY3G1000116"},{"$holds":true,"$ref":"1M6YBY3G10003MJ"}],"prose":"Position in the holarchy decides how far a holon may decide; authority is spread across levels yet still thickens toward the top.","title":"Nesting sets the reach of freedom"},"id":"1M6YBY3G2000076","instance":["1M6YBY3G000000K"]}
