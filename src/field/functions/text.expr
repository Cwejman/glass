// A holon's prose as text, at a depth of headings: a word as it was written, a sentence
// its words, a paragraph its sentences, marks around what they mark, and a whole as its
// name for a heading, its own words, and then what it holds, each a level deeper.

(h, depth) => case(first(h.instance).name, {
  word: join([h.before, h.text, h.after]),
  codespan: join(["`", h.text, "`"]),
  closed: join(["`", h.text, "`"]),
  sentence: join(map(h.words, text), " "),
  paragraph: join(map(h.sentences, text), " "),
  link: join(["[", join(map(h.words, text), " "), "]"]),
  emphasis: join(["*", join(map(concat(h.words, h.sentences), text), " "), "*"]),
  strong: join(["**", join(map(concat(h.words, h.sentences), text), " "), "**"]),
  item: join([
    "- ",
    join(map(h.sentences, text), " "),
    if(h.list, join(["\n", text(h.list, depth)]))
  ]),
  list: join(map(h.items, i => text(i, depth)), "\n"),
  quote: join(map(h.prose, p => join(["> ", text(p, depth)])), "\n>\n"),
  code: join(["```", h.language, "\n", h.text, "\n```"]),
  break: else(h.mark, "---")
},
  // A whole: its heading, its own words, and what it holds, in the order it is read.
  join(
    concat(
      [join([
        get(["#", "##", "###", "####", "#####", "######"], if(lt(else(depth, 1), 6), add(else(depth, 1), -1), 5)),
        " ",
        else(h.name, if(h.order, join([h.order, ". ", h.as]), first(h.instance).name)),
        if(eq(first(h.instance).name, "brief"), null, join([" (", first(h.instance).name, ")"]))
      ])],
      keys(h)
        | filter(k => and(eq(kind(get(h, k)), "string"), not(has(["as", "path"], k))))
        | map(k => join([k, ": ", get(h, k)])),
      parts(h) | map(p => text(p, add(else(depth, 1), 1)))
    ),
    "\n\n"
  )
)
