// A holon's structure without its prose, to a depth: each whole that holds, by its
// name or what it is, its measure in tokens, and what it holds beneath, a level less
// deep each time. What has no name and holds no whole is left out.

(h, depth) => {
  name: else(h.name, first(h.instance).name),
  tokens: measure(h),
  holds: if(lt(1, else(depth, 1)),
    parts(h)
      | filter(p => or(kind(p.name) | eq("string"), lt(0, size(filter(parts(p), q => kind(q.name) | eq("string"))))))
      | map(p => outline(p, add(depth, -1))),
    size(parts(h)))
}
