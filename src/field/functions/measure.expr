// A holon, or a run of them, measured in tokens, as many as a reader takes in reading
// it whole: the words beneath it, and the words it and what it holds keep as strings,
// each holon counted once, at about 1.85 tokens to a word.

h => concat(h, follow(h, x => out(x) | filter(e => e.holds) | map(e => e.to)) | map(e => e.to))
  | distinct
  | map(x => if(
      eq(first(x.instance).name, "word"),
      1,
      keys(x)
        | filter(k => eq(kind(get(x, k)), "string"))
        | fold(0, (n, k) => add(n, size(words(get(x, k)))))
    ))
  | fold(0, (n, each) => add(n, each))
  | mul(1.85)
  | round
