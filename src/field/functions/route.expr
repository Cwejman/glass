// The way down to a holon from its store's level: each whole that holds it, from the
// top, taking at each step the first that holds it in the same store, and then itself.
// A holarchy that holds itself round is walked once, and the holon is never its own whole.

h => concat(
  follow(h, x => in(x) | filter(e => and(e.holds, eq(e.from.store, h.store))) | map(e => e.from) | take(1))
    | map(e => e.to)
    | distinct
    | filter(x => not(eq(x, h)))
    | reverse,
  [h]
)
