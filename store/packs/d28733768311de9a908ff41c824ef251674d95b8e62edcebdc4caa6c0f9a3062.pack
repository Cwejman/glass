{"body":{"says":"One session of work with the author: when it ran, what it stood beside, the words it received in order, and the paths of evolution it noted."},"id":"01M6RBNRG0HPKFKVC8BXEVQEX0","instance":[],"kind":"version","mould":{"beside":{"optional":true,"says":"What ran beside it, as the arity of sessions grows: a note in words until that session is a holon to point at.","shape":"string"},"ended":{"optional":true,"says":"How its end was declared, where it was declared: a session is ended by being said to end.","shape":"string"},"forkedAt":{"holds":false,"optional":true,"says":"The utterance of that session at which it was forked.","shape":"ref"},"forkedFrom":{"holds":false,"optional":true,"says":"For a session forked from another: the session it was forked from.","shape":"ref"},"notes":{"holds":false,"optional":true,"says":"Holons it wrote that stand on their own and that it points at, such as a licence reading.","shape":{"set":"ref"}},"on":{"says":"The day it ran.","shape":"date"},"paths":{"holds":true,"says":"Paths of evolution the session noted, in the order noted.","shape":{"list":"ref"}},"said":{"holds":true,"says":"The author's utterances, in the order they came.","shape":{"list":"ref"}},"sent":{"holds":true,"optional":true,"says":"The messages it sent to other sessions, where their timelines meet: held as its own.","shape":{"list":"ref"}},"title":{"says":"The session in a few words.","shape":"string"}},"name":"session","prev":null}
{"body":{"says":"One expression of the author's, as one message: a stretch of time in which his words bounce off each other more than off the same words elsewhere. Its parts are paragraphs and breaks, in order."},"id":"01M6RBNRG13EAC8X77SR0W8A2S","instance":[],"kind":"version","mould":{"as":{"says":"How it came: typed or spoken.","shape":"string"},"flow":{"holds":true,"says":"Its paragraphs and breaks, in order.","shape":{"list":"ref"}},"order":{"says":"Its place in the session.","shape":"number"}},"name":"utterance","prev":null}
