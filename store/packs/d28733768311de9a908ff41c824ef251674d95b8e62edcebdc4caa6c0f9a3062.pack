{"body":{"says":"A table, kept closed as its lines for now: opening its rows and cells into holons is left for when it is attuned to."},"id":"01M6SMW4065PQXF13GZK9ME8MZ","instance":[],"kind":"version","mould":{"rows":{"says":"Its lines, as written.","shape":{"list":"string"}}},"name":"table","prev":null}
