// A holon cut into pieces a reader can take at once, in the order it is read: itself,
// if it fits the budget of tokens, else what it holds, each cut in turn, and pieces side
// by side packed into one while they fit together. A piece is a run of holons; one that
// holds nothing is given whole, however large.

(h, budget) => if(and(lt(budget, measure(h)), lt(0, size(parts(h)))),
  parts(h)
    | map(p => digest(p, budget))
    | fold([], (all, runs) => concat(all, runs))
    | fold([], (runs, run) => if(
        and(lt(0, size(runs)), not(lt(budget, measure(concat(last(runs), run))))),
        concat(take(runs, add(size(runs), -1)), [concat(last(runs), run)]),
        concat(runs, [run])
      )),
  [[h]]
)
