{"body":{"css":"/* Glass's material: everything drawn is made of these names, and nothing\n   else. Colours come in a light and a dark; type is a serif to read in and a\n   sans for what stands around the reading; the measure keeps a line short\n   enough to read. */\n\n:root {\n  --ground: #fbfaf7;\n  --raised: #ffffff;\n  --ink: #23211d;\n  --quiet: #6f6a61;\n  --line: #e4e0d7;\n  --accent: #3d5a80;\n\n  --serif: \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif;\n  --sans: ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif;\n  --mono: ui-monospace, \"SF Mono\", Menlo, Consolas, monospace;\n\n  --text: 18px;\n  --leading: 1.6;\n  --leading-close: 1.5;\n  --leading-tight: 1.2;\n  --lead: 1.12em;\n  --aside: 0.93em;\n  --code: 0.8em;\n  --title: 2rem;\n  --heading: 1.1rem;\n  --small: 0.875rem;\n  --smaller: 0.75rem;\n\n  --measure: 40rem;\n  --gap: 1rem;\n  --inset: 0.8em 1em;\n  --radius: 8px;\n  --pill: 99px;\n  --hairline: 1px;\n  --rule: 3px;\n\n  color-scheme: light dark;\n}\n\n@media (prefers-color-scheme: dark) {\n  :root {\n    --ground: #171614;\n    --raised: #1e1d1a;\n    --ink: #e8e4dc;\n    --quiet: #9b958a;\n    --line: #2f2c28;\n    --accent: #9db4d6;\n  }\n}\n\nbody {\n  margin: 0;\n  background: var(--ground);\n  color: var(--ink);\n  font: var(--text) / var(--leading) var(--serif);\n  -webkit-font-smoothing: antialiased;\n}\n\n#glass {\n  max-width: var(--measure);\n  min-height: 100dvh;\n  margin: 0 auto;\n  padding: 0 var(--gap);\n}\n\na {\n  color: var(--accent);\n}\n\ncode,\npre {\n  font-family: var(--mono);\n}\n\n.glass-note {\n  color: var(--quiet);\n  font: var(--small) / var(--leading-close) var(--sans);\n}\n\n/* A place: what a mount draws whole. The way down to it stands above its\n   title, quiet, in the sans. */\n\n.place > nav {\n  font: var(--small) / var(--leading-close) var(--sans);\n  color: var(--quiet);\n  margin-bottom: calc(var(--gap) * 2.5);\n}\n\n.place > nav a {\n  color: inherit;\n  text-decoration: none;\n}\n\n.place > nav a:hover {\n  color: var(--ink);\n}\n\n.place > nav a + a::before {\n  content: \"›\";\n  margin: 0 0.5em;\n  opacity: 0.6;\n}\n\n.place > h1 {\n  font-size: var(--title);\n  line-height: var(--leading-tight);\n  font-weight: 600;\n  margin: 0 0 calc(var(--gap) * 1.25);\n  letter-spacing: -0.01em;\n}\n\n.place > h2 {\n  font: var(--small) / var(--leading-close) var(--sans);\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n  color: var(--quiet);\n  margin: calc(var(--gap) * 2.5) 0 calc(var(--gap) * 0.75);\n}\n\n.place pre {\n  background: var(--raised);\n  border: var(--hairline) solid var(--line);\n  border-radius: var(--radius);\n  padding: var(--inset);\n  overflow: auto;\n  max-height: 32rem;\n  font-size: var(--code);\n  line-height: var(--leading-close);\n}\n\n/* What is said about a thing beside it, small and quiet. */\n\n.meta {\n  display: block;\n  font: var(--smaller) / var(--leading-close) var(--sans);\n  color: var(--quiet);\n}\n\n/* A card: what a face slot draws, entered by a press. The slot is what is\n   pressed and focused, so it is the slot that marks the card. */\n\n.card {\n  display: block;\n  padding: var(--gap) calc(var(--gap) * 1.15);\n  border: var(--hairline) solid var(--line);\n  border-radius: var(--radius);\n  background: var(--raised);\n  cursor: pointer;\n  transition: border-color 0.15s;\n}\n\n.slot.face:hover > .card,\n.slot.face:focus-visible > .card {\n  border-color: var(--quiet);\n}\n\n.slot.face:focus-visible {\n  outline: none;\n}\n\n.card .meta {\n  margin-top: 0.5em;\n}\n\n/* A list: its items one under another. */\n\n.list {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n  display: grid;\n  gap: calc(var(--gap) * 0.75);\n}\n\n/* A component made of data: its mounts one under another, set off by\n   space. */\n\n.template {\n  padding: calc(var(--gap) * 3) 0 calc(var(--gap) * 6);\n}\n\n.template > .slot + .slot {\n  margin-top: calc(var(--gap) * 2);\n}\n\n/* A grouping's collections, one under another, or side by side as cards\n   where there is room. */\n\n.collections {\n  display: grid;\n  gap: calc(var(--gap) * 0.75);\n  margin: 0 0 calc(var(--gap) * 1.5);\n}\n\n.collections.cards {\n  grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));\n}\n\n/* A collection standing open: its name, and the holons it holds named\n   beneath it, set apart by spacing alone. */\n\n.collection-open {\n  padding: 0.4rem 0;\n  cursor: pointer;\n}\n\n.collection-open > .meta {\n  display: inline;\n  margin-left: 0.6em;\n}\n\n.collection-open .members {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: baseline;\n  gap: 0.15rem 0.9rem;\n  margin-top: 0.35rem;\n  font: var(--small) / var(--leading-close) var(--sans);\n}\n\n.collection-open .member {\n  padding: 0;\n  border: 0;\n  background: none;\n  color: var(--ink);\n  font: inherit;\n  cursor: pointer;\n}\n\n.collection-open .member:hover,\n.collection-open .member:focus-visible {\n  text-decoration: underline;\n  outline: none;\n}\n\n/* A list's items as cards, side by side where there is room. */\n\n.list.cards {\n  grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));\n}\n\n/* A search: where one stands, its parts as chips beside what is typed,\n   and what is found beneath. Above what it searches from, it stays at the\n   top as the page moves, and shows what it found while it holds the\n   focus; in a menu, always. */\n\n.search {\n  position: relative;\n  font: var(--small) / var(--leading-close) var(--sans);\n}\n\n.template > .slot:first-child:has(> .search) {\n  position: sticky;\n  top: 0;\n  z-index: 5;\n  background: var(--ground);\n  padding: 0.6rem 0;\n  margin-top: calc(var(--gap) * -2);\n}\n\n.search-field {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.3rem;\n  padding: 0.35rem 0.45rem;\n  background: var(--raised);\n  border: var(--hairline) solid var(--line);\n  border-radius: var(--radius);\n}\n\n.search-field:focus-within {\n  border-color: var(--quiet);\n}\n\n.search .part {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.15rem;\n  padding: 0.15em 0.25em 0.15em 0.6em;\n  border: 0;\n  border-radius: var(--pill);\n  background: var(--line);\n  color: var(--ink);\n  font: inherit;\n  white-space: nowrap;\n}\n\n.search button.part {\n  padding-right: 0.6em;\n  background: none;\n  color: var(--quiet);\n  cursor: pointer;\n}\n\n.search button.part:hover,\n.search button.part:focus-visible {\n  color: var(--ink);\n  outline: none;\n}\n\n.search .part-change {\n  display: inline-flex;\n  gap: 0.3em;\n  padding: 0;\n  border: 0;\n  background: none;\n  color: inherit;\n  font: inherit;\n  cursor: pointer;\n}\n\n.search .part-change:disabled {\n  cursor: default;\n}\n\n.search .part-field {\n  color: var(--quiet);\n}\n\n.search .part-change:not(:disabled):hover .part-value,\n.search .part-change:focus-visible .part-value {\n  text-decoration: underline;\n  outline: none;\n}\n\n.search .part.pending {\n  padding-right: 0.6em;\n  background: none;\n  color: var(--accent);\n  font-weight: 600;\n}\n\n.search .part.pending[hidden] {\n  display: none;\n}\n\n.search .let-go {\n  border: 0;\n  background: none;\n  color: var(--quiet);\n  font: inherit;\n  line-height: 1;\n  padding: 0 0.3em;\n  border-radius: var(--pill);\n  cursor: pointer;\n}\n\n.search .let-go:hover,\n.search .let-go:focus-visible {\n  color: var(--ink);\n  background: var(--ground);\n  outline: none;\n}\n\n.search-input {\n  flex: 1 1 10rem;\n  min-width: 8rem;\n  padding: 0.25em 0.2em;\n  border: 0;\n  background: none;\n  color: var(--ink);\n  font: inherit;\n  outline: none;\n}\n\n.search-status {\n  margin: 0.35rem 0 0;\n  padding: 0 0.5rem;\n  color: var(--quiet);\n  font-size: var(--smaller);\n}\n\n.search-found {\n  display: none;\n  list-style: none;\n  margin: 0.3rem 0 0;\n  padding: 0.3rem;\n  max-height: min(24rem, 60vh);\n  overflow-y: auto;\n  background: var(--raised);\n  border: var(--hairline) solid var(--line);\n  border-radius: var(--radius);\n}\n\n.search:focus-within .search-found:not(:empty),\n.search.pressed .search-found:not(:empty) {\n  display: block;\n}\n\n.slot:not(.menu *) > .search .search-found {\n  position: absolute;\n  left: 0;\n  right: 0;\n  box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 0.12);\n}\n\n.found {\n  display: flex;\n  align-items: center;\n  gap: 0.3rem;\n  border-radius: calc(var(--radius) - 2px);\n}\n\n.found.active,\n.found:hover {\n  background: var(--ground);\n}\n\n.found .lead {\n  flex: 1;\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 1rem;\n  min-width: 0;\n  padding: 0.4rem 0.55rem;\n  border: 0;\n  background: none;\n  color: var(--ink);\n  font: inherit;\n  text-align: left;\n  cursor: pointer;\n}\n\n.found-said {\n  display: block;\n  padding: 0.4rem 0.55rem;\n  color: var(--quiet);\n}\n\n.found-label {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.found .meta {\n  flex-shrink: 0;\n  max-width: 50%;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n/* A mount's menu: the search, laid where the press landed. */\n\n.menu {\n  position: fixed;\n  z-index: 10;\n  width: min(30rem, calc(100vw - 16px));\n  padding: 0.35rem;\n  background: var(--ground);\n  border: var(--hairline) solid var(--line);\n  border-radius: var(--radius);\n  box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 0.18);\n}\n","says":"Glass's own material: a warm ground in light and dark, a serif to read in, a sans around the reading, and a short measure."},"id":"1M6YD90YH1TJ00P","instance":["1M6YD90YH1TJ005"],"name":"Glass"}
{"body":{"code":"// field/components/jsx.ts\nfunction h(tag, props, ...children) {\n  if (typeof tag === \"function\")\n    return tag({ ...props, children });\n  const made = document.createElement(tag);\n  for (const [key, value] of Object.entries(props ?? {}))\n    set(made, key, value);\n  made.append(...nodesOf(children));\n  return made;\n}\nfunction set(made, key, value) {\n  if (value === undefined || value === null)\n    return;\n  if (key.startsWith(\"on\")) {\n    if (typeof value === \"function\")\n      made.addEventListener(key.slice(2).toLowerCase(), value);\n  } else if (value === false) {\n    if (key.startsWith(\"aria-\"))\n      made.setAttribute(key, \"false\");\n  } else {\n    made.setAttribute(key, value === true ? \"\" : String(value));\n  }\n}\nfunction nodesOf(children) {\n  return children.flatMap((child) => {\n    if (Array.isArray(child))\n      return nodesOf(child);\n    if (child === null || child === undefined || typeof child === \"boolean\")\n      return [];\n    return [typeof child === \"number\" ? String(child) : child];\n  });\n}\n\n// field/components/menu.ts\nvar standing;\nfunction overlay(x, y, content, from, closed) {\n  standing?.();\n  const returnTo = document.activeElement ?? from;\n  const menu = document.createElement(\"div\");\n  menu.className = \"menu\";\n  menu.setAttribute(\"role\", \"dialog\");\n  menu.append(content);\n  const keys = (event) => {\n    if (event.key === \"Escape\")\n      return event.preventDefault(), close();\n  };\n  const outside = (event) => !menu.contains(event.target) && close();\n  const lay = () => {\n    const { width, height } = menu.getBoundingClientRect();\n    menu.style.left = `${Math.max(8, Math.min(x, innerWidth - width - 8))}px`;\n    menu.style.top = `${Math.max(8, Math.min(y, innerHeight - height - 8))}px`;\n  };\n  const growing = new ResizeObserver(lay);\n  function close() {\n    growing.disconnect();\n    removeEventListener(\"pointerdown\", outside, true);\n    removeEv